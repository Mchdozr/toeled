        <div class="contact-card">
          <div class="contact-item">
            <p class="contact-item-p1">E-mail:</p>
            <p class="contact-item-p2">sales@qiangliled.com</p>
          </div>
          <div class="contact-item">
            <p class="contact-item-p1">Tel:</p>
            <p class="contact-item-p2">+86 19044022069</p>
          </div>
          <div class="contact-item">
            <p class="contact-item-p1">Add:</p>
            <p class="contact-item-p2">No.5 Yutashi Road, Xiang'an District, Xiamen City, Fujian Province (Qiangli Jucai LED Display Industrial Park )</p>
          </div>
        </div>
      </div>
      <div class="public-footer-num">
        <p>Copyright &copy; Xiamen Qiangli Jucai Opto-electronic Technoloy Co., Ltd. All Rights Reserved</p>      </div>
    </div>
  </div>
</footer>
<!-- 右侧悬浮 -->
<div class="fixed-b">
<a href="javascript:;" class="fixed-b-i go-top">
    <img src="/public/wwwroot/images/kf.png" alt>
  </a>
  <a href="javascript:;" class="fixed-b-i go-top" id="gotop">
    <img src="/public/wwwroot/images/contact-top.png" alt>
  </a>
  <div class="fixed-b-i fixed-b-i-email">
    <img src="/public/wwwroot/images/contact-email.png" alt>
    <form id="fdForm" name="fdForm" url="/Feedback/submit" class="fixed-b-i-r">

      <div class="close">
        <img src="/public/wwwroot/images/icon-close.png" alt>
      </div>
      <p class="t1">Contact us</p>
      <p class="t2">
        Leave your message here and we will reply
        to you shortly
      </p>
      <div class="fixed-input items-center justify-between">
        <div class="fixed-input-i items-center">
          <span class="t1">Name *</span>
          <input class="inputs" type="text" name="name" datatype="*1-50" nullmsg="Please enter your name" errormsg="within 50 characters" sucmsg=" ">
        </div>
        <div class="fixed-input-i items-center">
          <span class="t1">Email *</span>
          <input class="inputs" type="text" name="email" datatype="e" nullmsg="Please enter your email" errormsg="Email format error" sucmsg=" ">
        </div>
      </div>
      <div class="fixed-input-i items-center">
        <span class="t1">Phone / WhatsApp / Wechat</span>
        <input class="inputs" type="text" name="telphone" datatype="*0-200" nullmsg="Please enter your Phone / WhatsApp / Wechat" errormsg="within 200 characters" sucmsg=" ">
      </div>
      <div class="fixed-input-i flex" style="padding: 15px 24px;border-radius: 20px;">
        <span class="t1">Message *</span>
        <textarea name="content" datatype="*1-500" nullmsg="Please leave your needs and suggestions" errormsg="Please leave your needs and suggestions" sucmsg=" " class="textarea"></textarea>
      </div>
      <button id="btnSubmit2" name="btnSubmit2" type="submit" class="fixed-input-btn">
        Submit
      </button>

    </form>
  </div>
</div>
<script>
  $(function() {
    $('body').click(function() {
      $('.fixed-b-i-r').fadeOut()
    })
    $('.fixed-b-i-email').on('click', function(event) {
      event.stopPropagation();
      $(this).children('.fixed-b-i-r').fadeIn()
      toggleCode();
      AjaxInitForm('#fdForm', '#btnSubmit2', 1);
    })
    $('.fixed-b-i-r .close').on('click', function(event) {
      event.stopPropagation();
      $(this).parent().fadeOut()
    })
  })
</script>
</body>

</html>