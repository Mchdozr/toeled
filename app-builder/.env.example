# Adobe I/O Runtime (filled by `aio app use` / `aio app deploy`)
AIO_runtime_auth=
AIO_runtime_namespace=
AIO_runtime_apihost=https://adobeioruntime.net

# Public URL of the deployed qce-cert-lookup web action.
# After deploy, paste this into qce-cert-lookup/index.html as TOELED_CERT_LOOKUP_URL.
# Example: https://<namespace>.adobeioruntime.net/api/v1/web/toeled/qce-cert-lookup
TOELED_CERT_LOOKUP_URL=
